<?xml version="1.0" encoding="utf-8"?>
<!-- Noor for Android TV, Google TV and Fire TV: one screen that shows the same web app as the
     Samsung build, from files inside the app. versionCode and versionName are set by
     scripts/build-android.sh from config.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.devmohammadsalameh.noor">

    <!-- weather, city search and the recitations -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Noor"
        android:icon="@mipmap/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Noor"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Noor as the TV's screensaver: Android starts it when the TV has been idle -->
        <service
            android:name=".NoorDream"
            android:exported="true"
            android:label="Noor"
            android:icon="@mipmap/icon"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
